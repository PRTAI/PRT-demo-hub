# Production only; preview uses a separate data directory and loopback address.
NODE_ENV=production
HOST=127.0.0.1
PORT=3100
APP_ORIGIN=https://demo.example.internal
PUBLIC_APP_ORIGIN=https://demo.example.internal
INTRANET_APP_ORIGIN=http://192.168.110.25:8001
DATA_DIR=./data

# Native run backup directory; Docker uses its /app/backups persistent volume.
# BACKUP_DIR=./backups

# Feishu application credentials. Never commit real credentials.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_TENANT_KEY=
FEISHU_DOCUMENT_PREVIEW=false
# Calendar invites and schedule cards use the same Feishu app credentials above.
# Enable bot ability, application calendar scopes and IM sending permission, then publish the app version.
# Optional private calendar with app writer/owner access; blank creates an app-owned calendar.
FEISHU_REQUIREMENT_CALENDAR_ID=
# Legacy sample location; optional tenant host hint for personal document links.
# Current synchronization uses the successful export and its PM user authorization, not sample access.
FEISHU_REQUIREMENT_WIKI_SAMPLE_URL=
# Optional parent wiki node for single and batch exports using the PM's user authorization.
# Creates children of this node; blank keeps exports in the PM's personal cloud root.
FEISHU_REQUIREMENT_EXPORT_WIKI_PARENT_URL=

# Shared official DeepSeek configuration for RAG and description generation.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_ENABLE_THINKING=false
# Leave token limits blank to omit max_tokens and use the model service default.
RAG_LLM_MAX_TOKENS=
RAG_LLM_REQUEST_TIMEOUT_MS=90000
DESCRIPTION_AGENT_MAX_TOKENS=
DESCRIPTION_AGENT_TIMEOUT_MS=180000
DESCRIPTION_AGENT_REQUEST_TIMEOUT_MS=90000

# Comma-separated Feishu open_ids; only grants the initial administrator.
BOOTSTRAP_ADMIN_OPEN_IDS=

# Must remain false in production.
DEMO_MODE=false

# Same-Feishu-app Harness integration; keep this server-only, matching PRT_DATAHUB_SECRET.
# Generate with openssl rand -base64 32. Required together with FEISHU_APP_ID and FEISHU_TENANT_KEY.
HARNESS_SHARED_SECRET=

# Optional center SSO: public center origin. Only this server may receive login codes.
HARNESS_SERVER_URL=

# Built-in DeepSeek operations employee. Uses the DEEPSEEK_* model settings above.
# Enable with compose.ops.yaml or update-docker.ps1 -EnableOps. No external Harness server is needed.
OPS_WORKER_TOKEN=
OPS_REASONING_EFFORT=max
OPS_MAX_TOKENS=
OPS_REQUEST_TIMEOUT_MS=300000
OPS_AGENT_TIMEOUT_MS=1800000
# Fine-grained GitHub token, scoped only to this repository: Contents read/write.
OPS_GITHUB_TOKEN=
OPS_GITHUB_REPOSITORY=PRTAI/PRT-demo-hub
OPS_GITHUB_BRANCH=feature/deepseek
OPS_GITHUB_BASE_BRANCH=main
# Host-local nightly backup. Successful snapshots replace only ops/latest.
# Set an absolute Linux directory instead when deploying on Ubuntu.
OPS_HOST_BACKUP_DIR=J:/PRT-backups/ops
