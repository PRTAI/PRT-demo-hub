# Production only; preview uses a separate data directory and loopback address.
NODE_ENV=production
HOST=127.0.0.1
PORT=3100
APP_ORIGIN=https://demo.example.internal
DATA_DIR=./data
# Native run backup directory; Docker uses its /app/backups persistent volume.
# BACKUP_DIR=./backups
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_TENANT_KEY=
# 阿里云百炼，用于基于数据说明的 RAG 智能检索。
DASHSCOPE_API_KEY=
RAG_LLM_MODEL=qwen-plus
# 数据说明生成使用独立 Claude Code Agent 配置，不与 RAG 共用。
DESCRIPTION_AGENT_API_KEY=
DESCRIPTION_AGENT_BASE_URL=
DESCRIPTION_AGENT_MODEL=
DESCRIPTION_AGENT_COMMAND=claude
# Comma-separated Feishu open_ids; only grants the initial administrator.
BOOTSTRAP_ADMIN_OPEN_IDS=
# Must remain false in production.
DEMO_MODE=false
